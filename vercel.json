{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/cron.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/setup.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/profile.js": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
